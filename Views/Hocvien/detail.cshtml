@model Hocvien
@{
	Layout = "~/Views/Shared/_Layout.cshtml";
	string resource = "~/resource/"+Model.Hinh;
}
<h1>Thông tin học viên</h1>
<dl class="row">
	<dt class="col-2">Mã học viên</dt>
	<dd class="col-10">@Model.Mshv</dd>
	<dt class="col-2">Tên học viên</dt>
	<dd class="col-10">@Model.Tenhv</dd>
	<dt class="col-2">Hình ảnh</dt>
	<dd class="col-10">
    @if (string.IsNullOrEmpty(Model.Hinh))
    {
		<form method="post" asp-action="selectImg" enctype="multipart/form-data">
			<div class="mb-3">
				<input type="file" id="img" name="img" class="form-control" />
				<input type="hidden" id="mshv" name="mshv" value="@Model.Mshv" />
			</div>
			<div class="mb-3">
				<button type="submit" class="btn btn-primary">Xác nhận</button>
			</div>
		</form>
		
    }
    else
    {
		<div class="mb-3">
			<img src="@Url.Content(resource)" height="180" width="150" />
        </div>
		<div class="mb-3">
		<	a class="btn btn-danger" asp-controller="Hocvien" asp-action="deleteImg">Xóa</	a>
		</div>
	}
	</dd>

</dl>
